# =====================================================================
# ARCS Part 4 — DESeq2 pipeline environment (Apptainer definition file)
#
# This file DEFINES a reproducible computing environment. Building it
# produces a single-file image (deseq2.sif) that runs the analysis
# identically on any Linux host — laptop, Codespace, or HPC.
#
# Build (on any Linux box, ONCE, ahead of class — it is slow):
#   apptainer build deseq2.sif deseq2.def
#
# In class students never build it; they pull the pre-built .sif and run:
#   apptainer exec ~/deseq2.sif Rscript scripts/pipeline.R
# =====================================================================

Bootstrap: docker
# Pinned to match Hour 1's renv.lock (Bioconductor 3.23, DESeq2 1.52).
# Hour 2's claim is that the container reproduces Hour 1 exactly, so if the
# lockfile moves to a newer Bioconductor release, move this with it —
# otherwise the figures drift apart even when the numbers agree.
#
# The tag pins the R patch version too (4.6.1). The bare RELEASE_3_23 tag
# would leave R free to change if the image is rebuilt, which is exactly the
# silent drift the build-your-own guide warns about. Hour 1's lockfile
# records R 4.6.0; a patch release apart is not expected to move results,
# but bump the lockfile if you want them strictly identical.
From: bioconductor/bioconductor_docker:RELEASE_3_23-R-4.6.1

%labels
    Author       ARCS Workshop (Advancing Reproducibility with Computational Skills)
    Description  DESeq2 differential-expression environment for ARCS Part 4
    Version      2.0

%help
    Reproducible R environment for the ARCS Part 4 DESeq2 pipeline —
    the same Shank3 vs WT analysis taught in Hour 1.

    Run the pipeline from workshops/arcs_04/_materials:
        apptainer exec deseq2.sif Rscript scripts/pipeline.R
    Or use the built-in runscript (same thing):
        apptainer run deseq2.sif

    Contains: DESeq2, apeglm, ggplot2, dplyr, tibble, pheatmap, RColorBrewer

%post
    # ---- Install the analysis packages INTO the image -----------------
    # This is the slow step (Bioconductor compiles) and is exactly why we
    # build the image ONCE, ahead of time, instead of in a live session.
    #
    # Bioconductor packages. apeglm backs lfcShrink() in the pipeline.
    R -e 'BiocManager::install(c("DESeq2", "apeglm"), update = FALSE, ask = FALSE)'

    # CRAN packages: plotting, data wrangling, and the QC heatmap.
    R -e 'install.packages(c("ggplot2", "dplyr", "tibble", "pheatmap", "RColorBrewer"), repos = "https://cloud.r-project.org")'

    # Fail the build early and loudly if anything did not install, rather
    # than shipping an image that breaks in front of a room of learners.
    R -e 'lapply(c("DESeq2","apeglm","ggplot2","dplyr","tibble","pheatmap","RColorBrewer"), function(p) library(p, character.only = TRUE))'

%environment
    # Settings applied to every shell INSIDE the container at run time.
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%runscript
    # What `apptainer run deseq2.sif` does: run the pipeline relative to
    # the current working directory (Apptainer auto-mounts it).
    exec Rscript scripts/pipeline.R "$@"

%test
    # Runs at the END of `apptainer build` to confirm the image is sane.
    # Checks every package the pipeline actually loads, so a partial
    # install is caught here rather than mid-workshop.
    R -e 'pkgs <- c("DESeq2","apeglm","ggplot2","dplyr","tibble","pheatmap","RColorBrewer"); \
          missing <- pkgs[!sapply(pkgs, requireNamespace, quietly = TRUE)]; \
          if (length(missing)) stop("MISSING: ", paste(missing, collapse=", ")); \
          cat("All packages OK\n")'
